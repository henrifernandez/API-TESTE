{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0"
    }
  },
  "routes": [
    { "src": "/(src|tests|vendor|\\.github)(/.*)?", "status": 404 },
    { "src": "/(composer\\.(json|lock)|phpunit\\.xml\\.dist|phpstan\\.neon\\.dist|\\.php-cs-fixer\\.dist\\.php|router\\.php|\\.gitattributes|\\.gitignore|\\.vercelignore)", "status": 404 },
    { "src": "/api/(.*)", "dest": "/api/index.php" }
  ]
}
